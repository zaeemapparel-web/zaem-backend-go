# ==================== SERVER ====================
PORT=5000
ENV=development

# ==================== DATABASE (SUPABASE) ====================
# Get from: Supabase Dashboard -> Settings -> Database -> Connection String -> Session Pooler
DATABASE_URL=

# ==================== JWT ====================
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=30d

# ==================== FRONTEND ====================
FRONTEND_URL=http://localhost:3000

# ==================== EMAIL (RESEND) ====================
# Get from: https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM="ZAEM <orders@zaemstore.com>"
EMAIL_REPLY_TO=zaemlifestyle@gmail.com

# ==================== AI (GROQ) ====================
# Get from: https://console.groq.com/keys
GROQ_API_KEY=